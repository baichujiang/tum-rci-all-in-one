  "rules": [
    {
      "id": "J_MIN_6",
      "scope": "degree",
      "summary_zh": "J至少6ECTS；未发现J整体最高6ECTS的规则。",
      "source_ids": [
        "FPSO",
        "RCI"
      ],
      "verification": "verified official rule",
      "enforcement": "numeric",
      "minimum_ects": 6,
      "maximum_ects": null
    },
    {
      "id": "J_NOT_PROFESSIONAL_SUBSTITUTE",
      "scope": "degree",
      "summary_zh": "J多修不能据此减少GHI法定最低41或条件36；规划桶封顶6不是法律最高值。",
      "source_ids": [
        "FPSO"
      ],
      "verification": "verified official rule",
      "enforcement": "numeric"
    },
    {
      "id": "J_MEMBERSHIP",
      "scope": "all_modules",
      "summary_zh": "须有适用RCI目录J归属或官方明确允许的渠道；跨学院本身不构成认可依据。",
      "source_ids": [
        "RCI",
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "source_gate"
    },
    {
      "id": "J_ONE_MODULE_ONCE",
      "scope": "all_modules",
      "summary_zh": "同一模块在本专业仅计一次；同码多分支去重。",
      "source_ids": [
        "APSO"
      ],
      "verification": "verified official rule",
      "enforcement": "exact_code"
    },
    {
      "id": "J_BACHELOR_COUNTED",
      "scope": "all_modules",
      "summary_zh": "本科已计入的二选一/选修模块不可再选入硕士。",
      "source_ids": [
        "APSO",
        "RECOGNITION"
      ],
      "verification": "verified official rule",
      "enforcement": "personal_confirmation",
      "not_a_blanket_ban_on_all_prior_mandatory_achievement_recognition": true
    },
    {
      "id": "J_SIMILARITY_REVIEW",
      "scope": "all_modules",
      "summary_zh": "专业相近或标题相似不能直接判为违法重复；明确等价、替代和实际重复计入需个人/学校核对。",
      "source_ids": [
        "APSO",
        "CIT"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard",
      "automatic_degree_name_blacklist": false
    },
    {
      "id": "LANG_PROVIDER",
      "scope": "language_courses",
      "summary_zh": "语言课须为TUM语言中心或交换期间TUM伙伴高校课程。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "source_gate"
    },
    {
      "id": "LANG_MAX_6",
      "scope": "language_courses",
      "summary_zh": "每个学位语言课最多计6ECTS，含专业语言课。",
      "source_ids": [
        "CIT_EN"
      ],
      "verification": "verified official rule",
      "enforcement": "numeric",
      "maximum_ects": 6
    },
    {
      "id": "LANG_DE_RCI_C12",
      "scope": "german_language_courses",
      "summary_zh": "RCI德语最低C1.2，覆盖一般Informatik低等级允许。",
      "source_ids": [
        "RCI"
      ],
      "verification": "verified official rule",
      "enforcement": "level_gate",
      "minimum_level": "C1.2"
    },
    {
      "id": "LANG_DE_PERSONAL",
      "scope": "german_language_courses",
      "summary_zh": "德语须非母语且本科不是德语授课；个人资料不能由国籍单独推断。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "personal_confirmation"
    },
    {
      "id": "LANG_EN_C2",
      "scope": "english_language_courses",
      "summary_zh": "硕士英语须C2，C1–C2课程明确不能计入。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "level_gate",
      "accepted_level": "C2",
      "explicitly_excluded_ranges": [
        "C1-C2"
      ]
    },
    {
      "id": "LANG_OTHER_NATIVE",
      "scope": "other_language_courses",
      "summary_zh": "其他语言可选各级，但不得为本人母语。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "personal_confirmation"
    },
    {
      "id": "LANG_LOW_LEVEL_OVERLAP",
      "scope": "language_courses",
      "summary_zh": "A1至B2同语言重叠级别仅计一次；整级覆盖半级。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "level_coverage"
    },
    {
      "id": "LANG_ADVANCED_DIFFERENT_FOCUS",
      "scope": "language_courses",
      "summary_zh": "C1起同级可计不同内容课程；这不取消RCI德语/硕士英语门槛。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "content_review"
    },
    {
      "id": "LANG_PERSONAL_ELIGIBILITY",
      "scope": "language_courses",
      "summary_zh": "未核对个人适用、分班、历史语言计分、课程条件时不自动补入；英语母语一律禁认未找到明确通用条文。",
      "source_ids": [
        "CIT",
        "SZ_REGISTER"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    },
    {
      "id": "WTG_CREDIT_BEARING",
      "scope": "wtg_modules",
      "summary_zh": "WTG可计带ECTS且可在本学位修读的课；无ECTS参加证不能当学分。",
      "source_ids": [
        "CIT",
        "WTG_FAQ"
      ],
      "verification": "verified official rule",
      "enforcement": "source_gate"
    },
    {
      "id": "WTG_SAME_TITLE",
      "scope": "wtg_modules",
      "summary_zh": "同名仅学分数不同的版本最多计一种；不要求必须评成绩等级；正式合格且授ECTS的不评分课程也可认可。",
      "source_ids": [
        "CIT"
      ],
      "verification": "verified official rule",
      "enforcement": "family_max_one"
    },
    {
      "id": "J_MODULE_CONDITIONS",
      "scope": "all_modules",
      "summary_zh": "推荐背景不能改写成必须先通过某考试；明确申请、学位、导师、选拔等须分别核对。",
      "source_ids": [
        "SZ_REGISTER",
        "WTG_REGISTER",
        "PROJECTS"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    },
    {
      "id": "J_SOURCE_COMPLETENESS",
      "scope": "all_modules",
      "summary_zh": "身份/当前学年/学分/分类/周期/双语条件有未知、冲突或不定期，不自动补入。",
      "source_ids": [
        "RCI"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    },
    {
      "id": "J_SEAT_NOT_GUARANTEED",
      "scope": "all_modules",
      "summary_zh": "认可资格与获位分开；名额未知时只可作有条件候选，正式选拔/导师条件未确认者不自动补入。",
      "source_ids": [
        "SZ_REGISTER",
        "WTG_REGISTER",
        "WTG_FAQ"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    },
    {
      "id": "J_RECOGNIZED_PASSED_PRESERVE",
      "scope": "all_modules",
      "summary_zh": "保留已获认可的已修/自录记录；新门槛控制未来补入，不静默删除历史。",
      "source_ids": [],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    },
    {
      "id": "J_LANGUAGE_CLASSIFICATION",
      "scope": "all_modules",
      "summary_zh": "语言学习目标与授课语言分开；SZ前缀、英文授课或项目周分支不能单独决定语言资格。",
      "source_ids": [
        "SZ_ICC"
      ],
      "verification": "conservative product guard; not a new legal conclusion",
      "enforcement": "engineering_guard"
    }
  ],
